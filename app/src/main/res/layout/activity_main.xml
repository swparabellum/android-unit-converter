<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:padding="20dp"
    tools:context=".MainActivity">

    <!-- 상단 제목 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="단위 변환기"
        android:textColor="#1F2937"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 디스플레이 카드 영역 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDisplay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 단위 선택 버튼 (상단 우측 배치) -->
            <Button
                android:id="@+id/BtnUnitSelecter"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="kg to lb"
                android:textColor="#3B82F6"
                android:textSize="14sp"
                android:textStyle="bold"
                app:strokeColor="#3B82F6"
                app:strokeWidth="1dp" />

            <!-- 입력값 디스플레이 (textView1) -->
            <TextView
                android:id="@+id/textView1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:hint="0"
                android:textColor="#4B5563"
                android:textSize="24sp"
                tools:text="0 kg" />

            <!-- 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="#E5E7EB" />

            <!-- 결과값 디스플레이 (textView2) -->
            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:hint="0"
                android:textColor="#111827"
                android:textSize="32sp"
                android:textStyle="bold"
                tools:text="0 lb" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 키패드 영역 -->
    <LinearLayout
        android:id="@+id/keypadLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardDisplay">

        <!-- 1, 2, 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonNo1"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="1"
                android:textColor="#1F2937"
                android:textSize="22sp"
                app:cornerRadius="12dp"
                app:strokeColor="#E5E7EB" />

            <Button
                android:id="@+id/buttonNo2"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="2"
                android:textColor="#1F2937"
                android:textSize="22sp"
                app:cornerRadius="12dp"
                app:strokeColor="#E5E7EB" />

            <Button
                android:id="@+id/buttonNo3"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="3"
                android:textColor="#1F2937"
                android:textSize="22sp"
                app:cornerRadius="12dp"
                app:strokeColor="#E5E7EB" />
        </LinearLayout>

        <!-- 4, 5, 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonNo4"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="4"
                android:textColor="#1F2937"
                android:textSize="22sp"
                app:cornerRadius="12dp"
                app:strokeColor="#E5E7EB" />

            <Button
                android:id="@+id/buttonNo5"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="5"
                android:textColor="#1F2937"
                android:textSize="22sp"
                app:cornerRadius="12dp"
                app:strokeColor="#E5E7EB" />

            <Button
                android:id="@+id/buttonNo6"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="6"
                android:textColor="#1F2937"
                android:textSize="22sp"
                app:cornerRadius="12dp"
                app:strokeColor="#E5E7EB" />
        </LinearLayout>

        <!-- 7, 8, 9 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonNo7"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="7"
                android:textColor="#1F2937"
                android:textSize="22sp"
                app:cornerRadius="12dp"
                app:strokeColor="#E5E7EB" />

            <Button
                android:id="@+id/buttonNo8"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="8"
                android:textColor="#1F2937"
                android:textSize="22sp"
                app:cornerRadius="12dp"
                app:strokeColor="#E5E7EB" />

            <Button
                android:id="@+id/buttonNo9"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="9"
                android:textColor="#1F2937"
                android:textSize="22sp"
                app:cornerRadius="12dp"
                app:strokeColor="#E5E7EB" />
        </LinearLayout>

        <!-- . , 0 , DEL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonDot"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="."
                android:textColor="#1F2937"
                android:textSize="22sp"
                app:cornerRadius="12dp"
                app:strokeColor="#E5E7EB" />

            <Button
                android:id="@+id/buttonNo0"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="0"
                android:textColor="#1F2937"
                android:textSize="22sp"
                app:cornerRadius="12dp"
                app:strokeColor="#E5E7EB" />

            <Button
                android:id="@+id/buttonDel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="DEL"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="#EF4444"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>